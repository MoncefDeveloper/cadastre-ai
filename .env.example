# =========================================================================
# APPLICATION CORE
# =========================================================================
APP_NAME="Cadastre AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# =========================================================================
# LOGGING & MONITORING
# =========================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =========================================================================
# DATABASE CONFIGURATION (MySQL 8 / SQLite for Local Dev)
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cadastre_ai
DB_USERNAME=root
DB_PASSWORD=

# =========================================================================
# STORAGE, SESSION & QUEUE (Database-Backed Stack)
# =========================================================================
FILESYSTEM_DISK=public
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# =========================================================================
# CORS PERIMETER & FRAMER INTEGRATION
# =========================================================================
# Custom frontend domain. Wildcard *.framer.(app|website|ai) handled via regex in config/cors.php
FRONTEND_URL=https://cadastre.framer.ai

# =========================================================================
# PRIMARY MAILER & POSTMARK WEBHOOK ENGINE
# =========================================================================
# Local dev: use "log" or "postmark". Production: use "postmark"
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@moncefdev.me"
MAIL_FROM_NAME="Cadastre AI"

# Postmark Server API Token & Inbound routing mailbox hash
POSTMARK_API_KEY=your-postmark-server-token
POSTMARK_INBOUND_ADDRESS="your-mailbox-hash@inbound.postmarkapp.com"
POSTMARK_WEBHOOK_SECRET=your-custom-header-secret

# =========================================================================
# SECONDARY NOTIFICATION MAILER (Namecheap Private Email SMTP)
# =========================================================================
# Dedicated transport for high-volume internal agent notification alerts
NAMECHEAP_MAIL_HOST=mail.privateemail.com
NAMECHEAP_MAIL_PORT=465
NAMECHEAP_MAIL_ENCRYPTION=ssl
NAMECHEAP_MAIL_USERNAME=info@moncefdev.me
NAMECHEAP_MAIL_PASSWORD=your-namecheap-password
NAMECHEAP_MAIL_FROM_ADDRESS="info@moncefdev.me"
NAMECHEAP_MAIL_FROM_NAME="Cadastre AI Internal"

# =========================================================================
# AI COPILOT ENGINE (Google Gemini 3.5 Flash-Lite)
# =========================================================================
# Dual-key rotation array to handle high-velocity criteria extraction & compliance grading
GEMINI_API_KEY_1=your-gemini-api-key-primary
GEMINI_API_KEY_2=your-gemini-api-key-secondary

# =========================================================================
# PLATFORM SEEDING & GHOST ADMIN INITIALIZATION
# =========================================================================
# Initial root master administrator credentials
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL=superadmin@cadastre.test
SUPER_ADMIN_PASSWORD=password

# =========================================================================
# ASSET BUNDLING (Vite)
# =========================================================================
VITE_APP_NAME="${APP_NAME}"
